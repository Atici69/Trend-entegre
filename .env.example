# API sunucusu
NODE_ENV=production
PORT=3000
# GitHub Pages origin'i ve gerekiyorsa yerel geliştirme adresleri
CORS_ORIGINS=https://atici69.github.io,http://localhost:3000,http://127.0.0.1:3000

# Supabase (anon key public client config; service role key yalnızca sunucuda gizli kalır)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Virgülle ayrılmış yönetici e-posta izin listesi. Supabase Auth'ta bu e-postalar için kullanıcı oluşturun.
ADMIN_EMAILS=

# Pazaryeri API bilgileri yalnızca hosting sağlayıcısının secret/environment alanına girilmelidir.
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# Hepsiburada SIT / mağaza bilgileri
HEPSIBURADA_MERCHANT_ID=
HEPSIBURADA_SECRET_KEY=
HEPSIBURADA_USER_AGENT=

N11_API_KEY=
N11_API_SECRET=

AMAZON_SELLER_ID=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=

PAZARAMA_API_KEY=
PAZARAMA_API_SECRET=

OZON_CLIENT_ID=
OZON_API_KEY=
