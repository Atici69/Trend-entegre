# Trend-Entegre API sunucusu
NODE_ENV=production
PORT=3000

# GitHub Pages web uygulamasının izin verilen origin'i
CORS_ORIGINS=https://atici69.github.io,http://localhost:3000,http://127.0.0.1:3000

# Firebase Web SDK yapılandırması (Firebase Console > Project settings)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK servis hesabı JSON'u.
# Tam JSON'u tek satır olarak girin; yalnızca Render gibi sunucu ortamının gizli değişkenlerinde saklayın.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Yönetici erişimi verilecek e-posta adresleri (virgülle ayırın)
ADMIN_EMAILS=

# iyzico — ilk kurulum ve testler için sandbox kullanın.
# Sandbox: https://sandbox-api.iyzipay.com
# Canlı ortam: https://api.iyzipay.com (sandbox testleri tamamlanmadan değiştirmeyin)
IYZIPAY_API_KEY=
IYZIPAY_SECRET_KEY=
IYZIPAY_URI=https://sandbox-api.iyzipay.com
IYZIPAY_RETURN_URL=https://atici69.github.io/Trend-entegre/
IYZIPAY_ORDER_RETURN_URL=https://atici69.github.io/Trend-entegre/
IYZIPAY_CALLBACK_URL=

# Hepsiburada mağaza bağlantısı (isteğe bağlı)
HEPSIBURADA_MERCHANT_ID=
HEPSIBURADA_SECRET_KEY=
HEPSIBURADA_USER_AGENT=
