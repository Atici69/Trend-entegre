# Sunucu
NODE_ENV=development
PORT=3000
# Virgülle ayrılmış izinli web origin'leri. Örn: https://trend-entegre.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pazaryeri bilgileri: Gerçek değerleri yalnızca hosting ortamının Secret/Environment bölümüne girin.
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# Hepsiburada Developer Portal - OAuth Client Credentials (SIT/test credentials)
HEPSIBURADA_CLIENT_ID=
HEPSIBURADA_CLIENT_SECRET=

N11_API_KEY=
N11_API_SECRET=

AMAZON_SELLER_ID=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=

PAZARAMA_API_KEY=
PAZARAMA_API_SECRET=

OZON_CLIENT_ID=
OZON_API_KEY=
